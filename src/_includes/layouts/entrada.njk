---
layout: layouts/base.njk
---
{% set cat = categoria | categoriaInfo %}
{% set mad = madurez | madurezInfo %}
<div class="progreso-lectura" aria-hidden="true" style="--color-cat: {{ cat.color }};">
  <div class="progreso-lectura__barra"></div>
</div>
<article class="hoja" style="--color-cat: {{ cat.color }}; --color-cat-suave: {{ cat.colorSuave }};">
  <p class="hoja__volver"><a href="/entradas/">← volver al índice</a></p>

  <header class="hoja__cabecera">
    <p class="hoja__categoria">
      <a href="/entradas/?categoria={{ cat.slug }}">{{ cat.emoji }} {{ cat.nombre }}</a>
    </p>
    <h1 class="hoja__titulo" style="view-transition-name: titulo-{{ page.fileSlug }};">{{ title }}</h1>
    {% if sugeridoPor %}
    <p class="hoja__sugerida">💌 Sugerida por {{ sugeridoPor }}</p>
    {% endif %}
    <p class="hoja__fecha">
      {{ date | fechaLarga }} · {{ explicacion | tiempoLectura(analogia, puente, reflexion, content) }}
    </p>
    <p class="hoja__madurez" style="--color-mad: {{ mad.color }};">{{ mad.emoji }} {{ mad.etiqueta }}</p>
    <button type="button" id="boton-compartir" class="hoja__compartir" data-titulo="{{ title }}" data-url="{{ page.url | absoluteUrl(site.url) }}">
      <span aria-hidden="true">🔗</span> Compartir
    </button>
    <p class="hoja__compartir-mensaje" id="compartir-mensaje" aria-live="polite" hidden></p>
    {% if tags %}
    <ul class="hoja__tags">
      {% for tag in tags %}
      <li>#{{ tag }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </header>

  <div class="hoja__cuerpo">
    {% set citasInfo = [explicacion, analogia, puente, reflexion] | citas %}
    {% set explicacion = citasInfo.procesados[0] %}
    {% set analogia = citasInfo.procesados[1] %}
    {% set puente = citasInfo.procesados[2] %}
    {% set reflexion = citasInfo.procesados[3] %}
    {% if explicacion %}
    <section class="seccion seccion--explicacion">
      <h2 class="seccion__titulo">Explicación simple</h2>
      <div class="seccion__texto seccion__texto--capitular">{{ explicacion | markdown | safe }}</div>
    </section>
    {% endif %}

    {% if analogia %}
    <section class="seccion">
      <h2 class="seccion__titulo">🎨 Dibujo mental</h2>
      <div class="seccion__texto">{{ analogia | markdown | safe }}</div>
    </section>
    {% endif %}

    {% set relacionadasResueltas = relacionadas | resolverEntradas(collections.entradas) %}
    {% if puente or relacionadasResueltas.length %}
    <section class="seccion">
      <h2 class="seccion__titulo">🔗 Puente con otro tema</h2>
      {% if puente %}
      <div class="seccion__texto">{{ puente | markdown | safe }}</div>
      {% endif %}
      {% if relacionadasResueltas.length %}
      <ul class="relacionadas">
        {% for rel in relacionadasResueltas %}
        {% set relCat = rel.data.categoria | categoriaInfo %}
        <li>
          <a href="{{ rel.url }}" style="--color-cat: {{ relCat.color }};">{{ relCat.emoji }} {{ rel.data.title }}</a>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </section>
    {% endif %}

    {% if content and content | trim | length %}
    <section class="seccion">
      <h2 class="seccion__titulo">Notas adicionales</h2>
      <div class="seccion__texto">{{ content | safe }}</div>
    </section>
    {% endif %}

    {% if reflexion %}
    <section class="reflexion">
      <p class="reflexion__etiqueta">💭 Para seguir pensando</p>
      <div class="reflexion__texto">{{ reflexion | markdown | safe }}</div>
    </section>
    {% endif %}

    {% if citasInfo.fuentes.length %}
    <section class="seccion fuentes" aria-label="Fuentes citadas">
      <h2 class="seccion__titulo">📚 Fuentes</h2>
      <ol class="fuentes__lista">
        {% for fuente in citasInfo.fuentes %}
        <li id="fuente-{{ fuente.numero }}">
          <a href="{{ fuente.url }}" target="_blank" rel="noopener noreferrer">{{ fuente.url | hostnameLimpio }}</a>
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}

    <section class="reacciones" aria-label="Reacciones de los lectores">
      <p class="reacciones__pregunta">¿Cómo te dejó esta entrada?</p>
      <div class="reacciones__botones" id="reacciones-botones" data-entrada="{{ page.fileSlug }}">
        <button type="button" class="reaccion" data-emoji="mente">
          <span class="reaccion__emoji" aria-hidden="true">🤯</span>
          <span class="reaccion__conteo" data-conteo="mente">0</span>
        </button>
        <button type="button" class="reaccion" data-emoji="sorpresa">
          <span class="reaccion__emoji" aria-hidden="true">😮</span>
          <span class="reaccion__conteo" data-conteo="sorpresa">0</span>
        </button>
        <button type="button" class="reaccion" data-emoji="amor">
          <span class="reaccion__emoji" aria-hidden="true">🖤</span>
          <span class="reaccion__conteo" data-conteo="amor">0</span>
        </button>
      </div>
    </section>

    {% set variante = "entrada" %}
    {% include "partials/suscripcion.njk" %}
    {% set variante = "entrada" %}
    {% include "partials/redes.njk" %}
  </div>
</article>

<script>
  (function () {
    var barra = document.querySelector(".progreso-lectura__barra");
    if (!barra) return;

    function actualizar() {
      var alturaTotal = document.documentElement.scrollHeight - window.innerHeight;
      var progreso = alturaTotal > 0 ? (window.scrollY / alturaTotal) * 100 : 0;
      barra.style.width = Math.min(100, Math.max(0, progreso)) + "%";
    }

    window.addEventListener("scroll", actualizar, { passive: true });
    window.addEventListener("resize", actualizar);
    actualizar();
  })();
</script>
<script>
  (function () {
    var boton = document.getElementById("boton-compartir");
    if (!boton) return;
    var mensaje = document.getElementById("compartir-mensaje");

    function mostrarMensaje(texto) {
      if (!mensaje) return;
      mensaje.textContent = texto;
      mensaje.hidden = false;
      clearTimeout(mensaje._temporizador);
      mensaje._temporizador = setTimeout(function () {
        mensaje.hidden = true;
      }, 2500);
    }

    boton.addEventListener("click", function () {
      if (typeof enviarEvento === "function") enviarEvento("compartir_entrada");

      var datos = { title: boton.dataset.titulo, url: boton.dataset.url };

      if (navigator.share) {
        navigator.share(datos).catch(function () {});
        return;
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard
          .writeText(datos.url)
          .then(function () {
            mostrarMensaje("🔗 Enlace copiado");
          })
          .catch(function () {
            mostrarMensaje("No se pudo copiar el enlace");
          });
      }
    });
  })();
</script>
<script>
  (function () {
    var contenedor = document.getElementById("reacciones-botones");
    if (!contenedor) return;

    var entrada = contenedor.dataset.entrada;
    var claveVoto = "reaccion-" + entrada;
    var botones = contenedor.querySelectorAll(".reaccion");

    function pintar(conteos) {
      botones.forEach(function (boton) {
        var emoji = boton.dataset.emoji;
        var span = boton.querySelector("[data-conteo]");
        span.textContent = (conteos && conteos[emoji]) || 0;
      });
    }

    function marcarElegido(emoji) {
      botones.forEach(function (boton) {
        boton.classList.toggle("reaccion--elegido", boton.dataset.emoji === emoji);
        boton.disabled = true;
      });
    }

    fetch("/.netlify/functions/reacciones?entrada=" + encodeURIComponent(entrada))
      .then(function (respuesta) {
        return respuesta.json();
      })
      .then(function (datos) {
        if (datos && datos.ok) pintar(datos.conteos);
      })
      .catch(function () {});

    var yaVotado;
    try {
      yaVotado = localStorage.getItem(claveVoto);
    } catch (err) {
      yaVotado = null;
    }
    if (yaVotado) marcarElegido(yaVotado);

    botones.forEach(function (boton) {
      boton.addEventListener("click", function () {
        if (boton.disabled) return;
        var emoji = boton.dataset.emoji;

        marcarElegido(emoji);
        try {
          localStorage.setItem(claveVoto, emoji);
        } catch (err) {}
        if (typeof enviarEvento === "function") enviarEvento("reaccion_entrada", { emoji: emoji });

        fetch("/.netlify/functions/reacciones", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ entrada: entrada, emoji: emoji }),
        })
          .then(function (respuesta) {
            return respuesta.json();
          })
          .then(function (datos) {
            if (datos && datos.ok) pintar(datos.conteos);
          })
          .catch(function () {});
      });
    });
  })();
</script>
