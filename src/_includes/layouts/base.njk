<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set metaTitulo = titulo or title or site.titulo %}
  {% set metaDescripcion = descripcion or resumen or site.descripcion %}
  {% set urlAbsoluta = page.url | absoluteUrl(site.url) %}
  {% set imagenOg = "/img/og/og-default.png" | absoluteUrl(site.url) %}

  <title>{{ metaTitulo }}</title>
  <meta name="description" content="{{ metaDescripcion }}">
  <link rel="canonical" href="{{ urlAbsoluta }}">

  <meta property="og:type" content="{% if categoria %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.titulo }}">
  <meta property="og:title" content="{{ metaTitulo }}">
  <meta property="og:description" content="{{ metaDescripcion }}">
  <meta property="og:url" content="{{ urlAbsoluta }}">
  <meta property="og:image" content="{{ imagenOg }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.titulo }} — {{ site.subtitulo }}">
  <meta property="og:locale" content="es_ES">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitulo }}">
  <meta name="twitter:description" content="{{ metaDescripcion }}">
  <meta name="twitter:image" content="{{ imagenOg }}">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" href="/favicon-180-apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GGZTHBCX6D"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', { analytics_storage: 'denied' });
    gtag('js', new Date());
    gtag('config', 'G-GGZTHBCX6D');

    try {
      if (localStorage.getItem('cookies-decision') === 'aceptado') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
    } catch (err) {}

    function enviarEvento(nombre, parametros) {
      if (typeof gtag === "function") gtag("event", nombre, parametros || {});
    }
  </script>
</head>
<body>
  <div class="pagina">
    <div class="insignia-beta" aria-hidden="true">
      <span class="insignia-beta__cinta">✏️ Beta</span>
    </div>
    {% if site.aviso %}
    <div class="aviso" id="aviso" data-aviso-texto="{{ site.aviso }}">
      <div class="aviso__marquee">
        <div class="aviso__pista" id="aviso-pista">
          <span class="aviso__texto">📌 {{ site.aviso }}&nbsp;&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;&nbsp;</span>
          <span class="aviso__texto" aria-hidden="true">📌 {{ site.aviso }}&nbsp;&nbsp;&nbsp;&nbsp;•&nbsp;&nbsp;&nbsp;&nbsp;</span>
        </div>
      </div>
      <button type="button" class="aviso__cerrar" id="aviso-cerrar" aria-label="Cerrar aviso">×</button>
    </div>
    <script>
      (function () {
        var el = document.getElementById("aviso");
        if (!el) return;
        var clave = "aviso-cerrado";
        var texto = el.dataset.avisoTexto;
        try {
          if (localStorage.getItem(clave) === texto) {
            el.hidden = true;
          }
        } catch (err) {}

        var pista = document.getElementById("aviso-pista");
        if (pista && !el.hidden) {
          var ancho = pista.scrollWidth / 2;
          var velocidad = 42;
          var duracion = Math.max(9, ancho / velocidad);
          pista.style.animationDuration = duracion + "s";
        }

        var boton = document.getElementById("aviso-cerrar");
        boton.addEventListener("click", function () {
          el.hidden = true;
          try {
            localStorage.setItem(clave, texto);
          } catch (err) {}
        });
      })();
    </script>
    {% endif %}
    {% include "partials/header.njk" %}
    <main class="contenido">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
  </div>
  <div class="cookies-aviso" id="cookies-aviso" hidden>
    <p class="cookies-aviso__texto">Uso cookies solo para saber qué entradas se leen más (Google Analytics). Nada de anuncios ni venta de datos.</p>
    <div class="cookies-aviso__botones">
      <button type="button" id="cookies-rechazar" class="cookies-aviso__boton cookies-aviso__boton--secundario">Rechazar</button>
      <button type="button" id="cookies-aceptar" class="cookies-aviso__boton">Aceptar</button>
    </div>
  </div>
  <script>
    (function () {
      var clave = "cookies-decision";
      var banner = document.getElementById("cookies-aviso");
      if (!banner) return;

      var decision;
      try {
        decision = localStorage.getItem(clave);
      } catch (err) {
        decision = null;
      }
      if (decision) return;

      banner.hidden = false;

      function decidir(valor) {
        banner.hidden = true;
        try {
          localStorage.setItem(clave, valor);
        } catch (err) {}
        if (valor === "aceptado" && typeof gtag === "function") {
          gtag("consent", "update", { analytics_storage: "granted" });
        }
      }

      document.getElementById("cookies-aceptar").addEventListener("click", function () {
        decidir("aceptado");
      });
      document.getElementById("cookies-rechazar").addEventListener("click", function () {
        decidir("rechazado");
      });
    })();
  </script>
  <div class="bienvenida-modal" id="bienvenida-social" hidden>
    <div class="bienvenida-modal__fondo" id="bienvenida-social-fondo"></div>
    <div class="bienvenida-modal__tarjeta" role="dialog" aria-label="Bienvenida">
      <button type="button" class="bienvenida-modal__cerrar" id="bienvenida-social-cerrar" aria-label="Cerrar">×</button>
      <p class="bienvenida-modal__pin" id="bienvenida-social-icono" aria-hidden="true">📌</p>
      <h2 class="bienvenida-modal__titulo" id="bienvenida-social-titulo">¡Llegaste desde Pinterest!</h2>
      <p class="bienvenida-modal__texto">Bienvenido al cuaderno — aquí guardo curiosidades de ciencia, medicina y universo, explicadas simple. Dale una vuelta:</p>
      <a href="/entradas/" class="bienvenida-modal__boton">Explorar el cuaderno →</a>
    </div>
  </div>
  <script>
    (function () {
      var fuentes = {
        pinterest: { icono: "📌", titulo: "¡Llegaste desde Pinterest!", referrer: "pinterest." },
        instagram: { icono: "📷", titulo: "¡Llegaste desde Instagram!", referrer: "instagram." }
      };

      var params = new URLSearchParams(window.location.search);
      var origen = params.get("utm_source");
      if (!fuentes[origen]) {
        origen = null;
        if (document.referrer) {
          for (var clave in fuentes) {
            if (document.referrer.indexOf(fuentes[clave].referrer) !== -1) {
              origen = clave;
              break;
            }
          }
        }
      }

      if (!origen) return;

      var claveVista = "bienvenida-" + origen + "-vista";
      try {
        if (localStorage.getItem(claveVista)) return;
      } catch (err) {}

      var modal = document.getElementById("bienvenida-social");
      if (!modal) return;

      var fuente = fuentes[origen];
      document.getElementById("bienvenida-social-icono").textContent = fuente.icono;
      document.getElementById("bienvenida-social-titulo").textContent = fuente.titulo;
      modal.hidden = false;
      document.body.style.overflow = "hidden";

      try {
        localStorage.setItem(claveVista, "1");
      } catch (err) {}

      function cerrar() {
        modal.hidden = true;
        document.body.style.overflow = "";
      }

      document.getElementById("bienvenida-social-cerrar").addEventListener("click", cerrar);
      document.getElementById("bienvenida-social-fondo").addEventListener("click", cerrar);
    })();
  </script>
  <script>
    (function () {
      var boton = document.getElementById("boton-sorpresa");
      if (!boton) return;
      boton.addEventListener("click", function () {
        enviarEvento("click_sorprendeme");
        var urls = JSON.parse(boton.dataset.urls || "[]");
        if (!urls.length) return;
        var actual = decodeURIComponent(window.location.pathname);
        var candidatos = urls.filter(function (u) {
          return u !== actual;
        });
        var lista = candidatos.length ? candidatos : urls;
        window.location.href = lista[Math.floor(Math.random() * lista.length)];
      });
    })();
  </script>
  <script>
    document.addEventListener("click", function (evento) {
      var enlace = evento.target.closest("a");
      if (!enlace) return;
      if (!enlace.closest(".pie__redes, .cabecera__redes, .redes-cta__iconos")) return;
      var red = (enlace.getAttribute("aria-label") || "red").toLowerCase();
      enviarEvento("click_red_social", { red: red });
    });
  </script>
  <script id="vista-previa-datos" type="application/json">{{ collections.vistaPrevia | json | safe }}</script>
  <script src="/js/vista-previa.js"></script>
</body>
</html>
