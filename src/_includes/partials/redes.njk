{% if site.instagramUrl or site.pinterestUrl %}
<div class="redes-cta{% if variante %} redes-cta--{{ variante }}{% endif %}">
  <p class="redes-cta__texto">📌 Sígueme para verlo crecer</p>
  <svg class="redes-cta__flecha" viewBox="0 0 60 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M8 4 C 26 2, 6 24, 29 29" fill="none" stroke="var(--acento-suave)" stroke-width="2.5" stroke-linecap="round" />
    <path d="M19 26 L29 29 L25 39" fill="none" stroke="var(--acento-suave)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <p class="redes-cta__iconos">
    {% if site.instagramUrl %}
    <a href="{{ site.instagramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5.5" />
        <circle cx="12" cy="12" r="4.1" />
        <circle cx="17.35" cy="6.65" r="0.6" fill="currentColor" stroke="none" />
      </svg>
    </a>
    {% endif %}
    {% if site.pinterestUrl %}
    <a href="{{ site.pinterestUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9.5" />
        <path d="M10 17.5c.5-2.2 1.3-5.7 1.7-7.6M11.3 13.2c-.3.9-.1 1.8.8 1.8 1.7 0 2.9-1.9 2.9-4 0-1.9-1.4-3.3-3.5-3.3-2.5 0-4 1.9-4 3.9 0 .9.4 1.6.9 2" />
      </svg>
    </a>
    {% endif %}
  </p>
</div>
{% endif %}
