<header class="cabecera">
  <a href="/" class="cabecera__marca">
    <span class="cabecera__cinta" aria-hidden="true"></span>
    <span class="cabecera__titulo">{{ site.titulo }}</span>
  </a>
  <svg class="cabecera__trazo" viewBox="0 0 260 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M4 9 C 50 2, 90 14, 130 7 S 210 2, 256 9" fill="none" stroke="var(--acento-suave)" stroke-width="2.5" stroke-linecap="round" />
  </svg>
  <ul class="cabecera__paleta" aria-hidden="true">
    {% for cat in categorias %}
    <li style="--color-cat: {{ cat.color }};">{{ cat.emoji }}</li>
    {% endfor %}
  </ul>
  <p class="cabecera__subtitulo">{{ site.subtitulo }}</p>
  <nav class="cabecera__nav">
    <div class="cabecera__nav-links">
      <a href="/">Portada</a>
      <a href="/entradas/">Índice de entradas</a>
      <a href="/sobre/">Sobre este cuaderno</a>
      <a href="/mapa/">Mapa</a>
      <a href="/glosario/">Glosario A-Z</a>
      <a href="/sugerencia/">Sugerencia</a>
    </div>
    <div class="cabecera__nav-fila">
      {% if collections.entradas.length %}
      <button type="button" id="boton-sorpresa" class="boton-sorpresa" data-urls='{{ collections.entradas | urlsJSON | safe }}'>
        <span class="boton-sorpresa__dado" aria-hidden="true">🎲</span> Sorpréndeme
      </button>
      {% endif %}
      {% if site.instagramUrl or site.pinterestUrl %}
      <p class="cabecera__redes">
        {% if site.instagramUrl %}
        <a href="{{ site.instagramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5.5" />
            <circle cx="12" cy="12" r="4.1" />
            <circle cx="17.35" cy="6.65" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
        {% endif %}
        {% if site.pinterestUrl %}
        <a href="{{ site.pinterestUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9.5" />
            <path d="M10 17.5c.5-2.2 1.3-5.7 1.7-7.6M11.3 13.2c-.3.9-.1 1.8.8 1.8 1.7 0 2.9-1.9 2.9-4 0-1.9-1.4-3.3-3.5-3.3-2.5 0-4 1.9-4 3.9 0 .9.4 1.6.9 2" />
          </svg>
        </a>
        {% endif %}
      </p>
      {% endif %}
    </div>
  </nav>
</header>
