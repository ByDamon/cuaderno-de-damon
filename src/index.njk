  <p class="portada__intro">{{ site.introPortada }}</p>
</section>

<section class="tal-dia" id="tal-dia" hidden aria-live="polite"></section>
<script id="tal-dia-datos" type="application/json">{{ collections.talDiaComoHoy | json | safe }}</script>
<script>
  (function () {
    var contenedor = document.getElementById("tal-dia");
    var datosEl = document.getElementById("tal-dia-datos");
    if (!contenedor || !datosEl) return;

    var entradas;
    try {
      entradas = JSON.parse(datosEl.textContent || "[]");
    } catch (err) {
      return;
    }

    var hoy = new Date();
    var mes = hoy.getMonth();
    var dia = hoy.getDate();
    var anioActual = hoy.getFullYear();

    var coincidencias = entradas
      .map(function (e) {
        var partes = e.fecha.split("-").map(Number);
        return { entrada: e, fecha: new Date(partes[0], partes[1] - 1, partes[2]) };
      })
      .filter(function (item) {
        return (
          item.fecha.getMonth() === mes &&
          item.fecha.getDate() === dia &&
          item.fecha.getFullYear() < anioActual
        );
      })
      .sort(function (a, b) {
        return a.fecha.getFullYear() - b.fecha.getFullYear();
      });

    if (!coincidencias.length) return;

    function etiquetaAnios(anios) {
      return anios === 1 ? "hace 1 año" : "hace " + anios + " años";
    }

    var html = '<p class="tal-dia__titulo">📌 Tal día como hoy…</p><ul class="tal-dia__lista">';
    coincidencias.forEach(function (item) {
      var e = item.entrada;
      var anios = anioActual - item.fecha.getFullYear();
      html +=
        '<li><a href="' + e.url + '" style="--color-cat: ' + e.color + '; --color-cat-suave: ' + e.colorSuave + ';">' +
        '<span class="tal-dia__antiguedad">' + etiquetaAnios(anios) + '</span>' +
        '<span class="tal-dia__entrada">' + e.emoji + " " + e.titulo + "</span>" +
        "</a></li>";
    });
    html += "</ul>";

    contenedor.innerHTML = html;
    contenedor.hidden = false;
  })();
</script>

<section class="portada__temas">
  <h2 class="portada__temas-titulo">Explora por tema</h2>
  <div class="temas">
    {% for cat in categorias %}
    <a class="tema" href="/entradas/?categoria={{ cat.slug }}" style="--color-cat: {{ cat.color }};">
      <span class="tema__emoji">{{ cat.emoji }}</span>
      <span class="tema__nombre">{{ cat.nombre }}</span>
      <span class="tema__descripcion">{{ cat.descripcion }}</span>
    </a>
    {% endfor %}
  </div>
</section>

<section class="ultimas">
  <h2 class="ultimas__titulo">Últimas páginas escritas</h2>
  <div class="tarjetas">
    {% for entrada in collections.entradas %}
      {% if loop.index <= 4 %}
      {% set cat = entrada.data.categoria | categoriaInfo %}
      <a class="tarjeta" href="{{ entrada.url }}" style="--color-cat: {{ cat.color }}; --color-cat-suave: {{ cat.colorSuave }};">
        <p class="tarjeta__categoria">{{ cat.emoji }} {{ cat.nombre }}</p>
        <h3 class="tarjeta__titulo" style="view-transition-name: titulo-{{ entrada.fileSlug }};">{{ entrada.data.title }}</h3>
        <p class="tarjeta__resumen">{{ entrada.data.resumen }}</p>
        <p class="tarjeta__fecha">{{ entrada.data.date | fechaCorta }}</p>
      </a>
      {% endif %}
    {% endfor %}
  </div>
  <p class="ultimas__ver-todas"><a href="/entradas/">Ver el índice completo →</a></p>
</section>
