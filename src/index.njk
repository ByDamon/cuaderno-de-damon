      <g>
        <ellipse cx="130" cy="100" rx="75" ry="26" transform="rotate(-18 130 100)" fill="none" stroke="#3a6ea5" stroke-width="2" opacity="0.9" />
        <circle cx="130" cy="100" r="9" fill="var(--papel)" stroke="#3a6ea5" stroke-width="2.5" />
        <circle cx="196" cy="83" r="5" fill="#3a6ea5" />
        <circle cx="55" cy="56" r="1.6" fill="#3a6ea5" opacity="0.6" />
        <circle cx="212" cy="62" r="1.4" fill="#3a6ea5" opacity="0.6" />
        <circle cx="68" cy="146" r="1.6" fill="#3a6ea5" opacity="0.6" />
      </g>

      <g>
        <ellipse cx="365" cy="100" rx="58" ry="22" fill="none" stroke="#4c8c62" stroke-width="2" opacity="0.9" />
        <ellipse cx="365" cy="100" rx="58" ry="22" fill="none" stroke="#4c8c62" stroke-width="2" opacity="0.9" transform="rotate(60 365 100)" />
        <ellipse cx="365" cy="100" rx="58" ry="22" fill="none" stroke="#4c8c62" stroke-width="2" opacity="0.9" transform="rotate(120 365 100)" />
